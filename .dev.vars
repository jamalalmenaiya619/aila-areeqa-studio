# Copy to .dev.vars for local runs (never commit .dev.vars).
# Test mode: no Supabase needed, data stays in the browser. Only works on localhost.
AUTH_MODE=test
COACH_FAKE=1
# Or use your real project instead of test mode:
# SUPABASE_URL=https://YOUR-PROJECT.supabase.co
# SUPABASE_ANON_KEY=your-anon-public-key
# ANTHROPIC_API_KEY=sk-ant-...
