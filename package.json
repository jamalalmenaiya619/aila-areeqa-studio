{
  "name": "aila-areeqa-studio",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run gen && tsc -p tsconfig.json && tsc -p functions/tsconfig.json && vite build && tsx scripts/check-build.ts",
    "typecheck": "tsc -p tsconfig.json && tsc -p functions/tsconfig.json",
    "test": "vitest run",
    "e2e": "playwright test",
    "migrate": "tsx scripts/migrate-studybook.ts && tsx scripts/migrate-intel.ts && tsx scripts/migrate-library.ts",
    "verify": "tsx scripts/verify-migration.ts",
    "gen": "tsx scripts/gen-drawings.ts && tsx scripts/gen-styles.ts",
    "serve": "wrangler pages dev dist --port 8788",
    "test:sql": "bash tests/sql/run.sh"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.3.0",
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.118.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.30.6"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261101.1",
    "@playwright/test": "^1.64.1",
    "@types/node": "^22.20.5",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^4.7.0",
    "node-html-parser": "^9.0.6",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vite": "^5.4.21",
    "vitest": "^2.1.9",
    "wrangler": "^4.156.0"
  }
}
